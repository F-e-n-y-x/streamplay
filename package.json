{
  "name": "streamplay-api",
  "version": "2.0.0",
  "description": "Self-hosted streaming hub: TMDB/AniList metadata, multi-provider stream extraction, HLS/torrent proxy, React web client.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm run build:client && tsc",
    "build:client": "npm --prefix client ci && npm --prefix client run build",
    "start": "node dist/index.js",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "compression": "^1.8.2",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "socks-proxy-agent": "^10.1.0",
    "webtorrent": "^2.5.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
