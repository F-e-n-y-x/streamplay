# ── StreamPlay configuration ─────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.

# Port the server listens on.
PORT=3000

# TMDB API key (v3 auth) — required for all metadata/browse/search.
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# FlareSolverr instance(s) used to bypass Cloudflare on scraping providers.
# In Docker Compose this points at the bundled flaresolverr service.
# Leave blank to disable the Cloudflare-gated scraping providers.
#
# Each FlareSolverr is a SINGLE browser, so it becomes a bottleneck when many
# providers need it at once (esp. the anime providers AnimePahe/AnimeWorld, which
# make several solves each). You can run MULTIPLE instances and list them
# comma-separated — StreamPlay round-robins across them so concurrent solves fan
# out over several browsers. Recommended: 2-3 instances for smooth anime scraping.
#   FLARESOLVERR_URL=http://flaresolverr:8191/,http://flaresolverr2:8191/,http://flaresolverr3:8191/
FLARESOLVERR_URL=http://flaresolverr:8191/

# Optional API key for WYZIE subtitles (free key at https://store.wyzie.io).
# Leave blank to disable the WyzieSubs provider.
WYZIE_KEY=

# ── TheTVDB (better cartoon + Indian/international series data) ────────────────
# TMDB orders cartoons (Ben 10) by AIR date and has thin coverage of many Indian /
# international series. TheTVDB has correct production/DVD orderings and far deeper
# coverage, so we use it to drive season/episode lists for NON-anime series when set.
# Get a free key at https://www.thetvdb.com → Dashboard → API.
# Leave blank to keep using TMDB for everything.
TVDB_API_KEY=
# Only if you use TVDB's free "user-supported" model (a subscriber PIN). Licensed
# keys don't need this — leave blank.
TVDB_PIN=

# Max time (ms) any single provider may take before the /api/streams route
# drops it and returns whatever the others produced.
PROVIDER_TIMEOUT_MS=45000

# ── Cloudflare WARP proxy (beat IP blocks / DNS poisoning) ────────────────────
# Some upstreams hard-block a home/datacenter egress IP (AnimePahe's Kwik CDN
# literally returns "your IP is banned"), or an ISP/NAS poisons provider CDNs.
# Routing through a Cloudflare WARP proxy (e.g. https://github.com/cmj2002/warp-docker)
# gives a clean egress IP that usually clears both. All WARP options are OPT-IN.
#
# WARP_MODE — the default mode (the Settings page can override per request):
#   off       never use WARP (default)
#   required  only providers that need it (e.g. AnimePahe) use WARP
#   fallback  try normally; if a provider returns nothing, retry it via WARP
#   all       route every provider request through WARP
WARP_MODE=off
# SOCKS5 proxy(ies) for StreamPlay's OWN outbound requests (warp-docker's default
# is a SOCKS5 proxy on :1080). Accepts a comma-separated LIST that is index-matched
# to WARP_FLARESOLVERR_URL below: entry N here pairs with FlareSolverr N, and one
# pair is pinned per provider run so its solve + follow-up requests share one IP.
#   WARP_PROXY_URL=socks5://warp:1080,socks5://warp2:1080,socks5://warp3:1080,socks5://warp4:1080
WARP_PROXY_URL=
# FlareSolverr instance(s) whose CONTAINER egresses through WARP. This is what
# fixes Kwik/AnimePahe, because the Cloudflare block happens inside the browser
# SOLVE, not our direct request. Accepts a comma-separated LIST (one per WARP
# proxy) and round-robins the WARP solve across them. See docker-compose.yml.
#   WARP_FLARESOLVERR_URL=http://warp:8191/,http://warp2:8191/,http://warp3:8191/,http://warp4:8191/
WARP_FLARESOLVERR_URL=

# ── DNS-over-HTTPS (DoH) ──────────────────────────────────────────────────────
# Resolve provider/CDN hostnames over HTTPS instead of the system/ISP resolver.
# Turn this ON if you see `/api/proxy` 502s that mention DNS (ENOTFOUND/EAI_AGAIN)
# or if some providers/streams never load — common on a NAS or an ISP that blocks
# or poisons these domains. It adds a tiny one-time lookup per host (then cached),
# so the performance impact is negligible.
#
# IMPORTANT with WARP: WARP does DNS for requests that go THROUGH it, but in
# WARP_MODE=required/off the DIRECT providers (e.g. AniZone) still use the system
# resolver. If your NAS/ISP poisons a provider host (anizone.to, a CDN…), that
# provider will fail/time out unless DoH is ON. On a NAS, keep this **true**.
DOH_ENABLED=true
# Which public resolver to use: google | cloudflare | quad9
DOH_PROVIDER=google
# Advanced overrides (optional): a custom JSON DoH endpoint, and the bootstrap IP
# used to reach it without the system resolver. Presets already cover the three
# providers above — only set these for a custom resolver.
# DOH_URL=https://dns.google/resolve
# DOH_BOOTSTRAP_IP=8.8.8.8

# Anime provider domains (rotate occasionally). AniZone is the active anime
# provider (HLS with JP/KR/EN audio + subtitles). AnimePahe is ready but its
# Kwik host may be IP-blocked from your FlareSolverr egress.
ANIZONE_BASE_URL=https://anizone.to
ANIMEPAHE_BASE_URL=https://animepahe.pw

# CastleTV secret suffix for AES decryption (Indian multi-language provider).
# Leave blank to disable CastleTV.
CASTLE_SUFFIX=

# Consumet aggregator (optional) — self-host the Consumet API and point here to add
# Zoro/AnimePahe/Gogoanime/AnimeKai anime with automatic fallback. Leave blank to disable.
# NOTE (Jul 2026): most of these back-ends are currently dead; kept for when they revive.
CONSUMET_URL=
CONSUMET_PROVIDERS=zoro,animepahe,animekai,gogoanime

# ── Torrent mode (anime via AnimeTosho/Nyaa + WebTorrent) ─────────────────────
# Enable per-device from the Providers page ("Torrent mode: ON"). Torrents are the
# most durable anime source (never rot, sub+dub 1080p, absolute-episode numbering).
# ffmpeg (bundled in the image) remuxes the usual .mkv releases to browser-playable
# MP4 on the fly; the raw file is always available for VLC.
#
# Where WebTorrent caches downloaded pieces (defaults to the OS temp dir; cleared on
# restart). Point at a Docker volume if you want the cache to persist.
# TORRENT_DIR=/app/data/torrents
# Evict a torrent after it's been unused this long (ms). Default 20 min.
# TORRENT_IDLE_MS=1200000
# Set to true to HEVC-transcode via VAAPI on an AMD/Intel iGPU (needs /dev/dri mapped
# into the container). Plain h264 releases are just remuxed (no GPU needed).
# TORRENT_VAAPI=false
#
# PRIVACY: WebTorrent peer traffic uses the container's DIRECT egress — it does NOT go
# through the WARP SOCKS proxy (WebTorrent can't proxy UDP/DHT). To hide your home IP
# from peers, run the streamplay container behind WARP at the network level
# (network_mode: service:warp) or a VPN.
#
# ── Debrid (STRONGLY recommended for reliable torrent streaming) ──────────────
# Set ONE debrid key and StreamPlay asks Torrentio to resolve torrents through it,
# returning DIRECT cached HTTP links that stream instantly with no P2P/buffering —
# this is how Stremio/Torrentio achieve reliable playback. Cached results are ranked
# first and labelled "Cached ⚡". Without a key, torrents fall back to P2P (WebTorrent
# with an expanded tracker list). Movies & TV use this today (anime stays on P2P).
#   RealDebrid (~€3/mo): https://real-debrid.com/apitoken
# REALDEBRID_KEY=
# ALLDEBRID_KEY=
# TORBOX_KEY=
# PREMIUMIZE_KEY=
# DEBRIDLINK_KEY=
# OFFCLOUD_KEY=

# ── Torznab meta-indexer: Jackett / Prowlarr (optional, big coverage boost) ───
# The *arr-stack way to get broad, reliable torrent results: one query fans out over
# every indexer you've configured in Jackett/Prowlarr (100s of public + private
# trackers). Feeds the Movie/TV/Anime torrent providers alongside YTS/EZTV/Torrentio.
# Point at Jackett (bare base URL — we build the all-indexers endpoint) OR a generic
# Torznab/Prowlarr feed URL. Newznab cats used: movies=2000, tv=5000, anime=5070.
# JACKETT_URL=http://jackett:9117
# JACKETT_API_KEY=your_jackett_api_key
#   …or a generic Torznab feed:
# TORZNAB_URL=http://host/api/v2.0/indexers/all/results/torznab/api
# TORZNAB_API_KEY=your_key
#   …or Prowlarr:
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=your_prowlarr_api_key

# ── Diagnostics hardening (optional) ──────────────────────────────────────────
# If set, /api/debug/provider requires ?token=<this> (locks the diagnostic down on a
# public instance without affecting the normal client). Leave blank to keep it open.
# DEBUG_TOKEN=
